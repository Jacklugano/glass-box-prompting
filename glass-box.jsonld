  "about": [
    {
      "@type": "DefinedTerm",
      "name": "Glass-Box publication",
      "description": "A publicly accessible document where an issuer declares the semantic conventions adopted in their professional documents."
    },
    {
      "@type": "DefinedTerm",
      "name": "Semantic anchoring",
      "description": "The practice of referencing public, externally-verifiable standards (national norms, official catalogs, regulations) as the authoritative source for terms used in professional documents."
    },
    {
      "@type": "DefinedTerm",
      "name": "Documentation, not instruction",
      "description": "Core GBP principle: a Glass-Box publication describes how the issuer interprets their own terms; it does not direct AI behavior or impose actions on any reader."
    }
  ],
  "foundingPrinciples": [
    {
      "name": "Total transparency",
      "description": "The issuer's semantic conventions are published in a form readable by anyone — humans, AI assistants, technical analysts. Nothing is hidden, encoded, or disguised as metadata."
    },
    {
      "name": "Documentation, not instruction",
      "description": "The protocol describes how the issuer interprets their own terms. It does not instruct AI on behavior, does not impose actions, does not attempt to influence reader judgment."
    },
    {
      "name": "Interoperability",
      "description": "Value grows with adoption. When two documents both adopt the protocol, semantic comparison becomes possible: each exposes its conventions, and the reader can objectively evaluate differences."
    }
  ],
